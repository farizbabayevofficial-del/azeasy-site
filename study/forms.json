ə","choices":[{"ru":"наоборот","en":"on the contrary","fr":"au contraire","tr":"aksine"},{"ru":"владелец, хозяин","en":"owner","fr":"propriétaire","tr":"sahip"},{"ru":"самолёт","en":"aeroplane","fr":"avion","tr":"uçak"},{"ru":"пускать, отпускать","en":"to let in, to let go","fr":"laisser entrer, laisser partir","tr":"bırakmak, izin vermek"}]},{"id":"B29","section":"reading","prompt":"Sonra yatıram.","choices":[{"ru":"Сколько стоит килограмм черешни?","en":"How much is a kilo of cherries?","fr":"Combien coûte un kilo de cerises ?","tr":"Kirazın kilosu kaç manat?"},{"ru":"Ваш брат студент.","en":"Your brother is a student.","fr":"Votre frère est étudiant.","tr":"Erkek kardeşiniz öğrenci."},{"ru":"Ты не можешь говорить.","en":"You cannot speak.","fr":"Tu ne peux pas parler.","tr":"Konuşamıyorsun."},{"ru":"Потом я сплю.","en":"Then I sleep.","fr":"Puis je dors.","tr":"Sonra uyuyorum."}]},{"id":"B30","section":"reading","prompt":"Bir qara pişik və bir ağ it var.","choices":[{"ru":"сорок девять","en":"Forty-nine.","fr":"Quarante-neuf.","tr":"kırk dokuz"},{"ru":"Рядом с Азербайджаном есть Грузия.","en":"Next to Azerbaijan there is Georgia.","fr":"À côté de l’Azerbaïdjan, il y a la Géorgie.","tr":"Azerbaycan’ın yanında Gürcistan var."},{"ru":"Минуту, потом позвоню.","en":"Just a minute, I will call later.","fr":"Une minute, j’appellerai plus tard.","tr":"Bir dakika, sonra ararım."},{"ru":"Есть чёрная кошка и белая собака.","en":"There is a black cat and a white dog.","fr":"Il y a un chat noir et un chien blanc.","tr":"Siyah bir kedi ve beyaz bir köpek var."}]},{"id":"B31","section":"reading","prompt":"Mətbəxdə stul yoxdur.","choices":[{"ru":"Эта сумка стоит пятьдесят манатов.","en":"This bag costs fifty manats.","fr":"Ce sac coûte cinquante manats.","tr":"Bu çanta elli manat."},{"ru":"На кухне нет стула.","en":"There is no chair in the kitchen.","fr":"Il n’y a pas de chaise dans la cuisine.","tr":"Mutfakta sandalye yok."},{"ru":"Сколько баклажанов вы хотите?","en":"How many aubergines would you like?","fr":"Combien d’aubergines voulez-vous ?","tr":"Kaç patlıcan istiyorsunuz?"},{"ru":"Мои родители учителя.","en":"My parents are teachers.","fr":"Mes parents sont professeurs.","tr":"Anne babam öğretmen."}]},{"id":"B32","section":"reading","prompt":"Evdə musiqi mənim xoşuma gəlir.","choices":[{"ru":"Я не вижу.","en":"I do not see.","fr":"Je ne vois pas.","tr":"Görmüyorum."},{"ru":"На карте Китай — большая страна.","en":"On the map China is a big country.","fr":"Sur la carte, la Chine est un grand pays.","tr":"Haritada Çin büyük bir ülke."},{"ru":"Дома мне нравится музыка.","en":"At home I like music.","fr":"À la maison, j’aime la musique.","tr":"Evde müzik hoşuma gidiyor."},{"ru":"Нет, не пью. Я пью кофе.","en":"No, I do not. I drink coffee.","fr":"Non, je n’en bois pas. Je bois du café.","tr":"Hayır, içmiyorum. Kahve içiyorum."}]},{"id":"B33","section":"reading","prompt":"Saat üçdə.","choices":[{"ru":"В три часа.","en":"At three o’clock.","fr":"À trois heures.","tr":"Saat üçte."},{"ru":"В сумке два ключа.","en":"There are two keys in the bag.","fr":"Il y a deux clés dans le sac.","tr":"Çantada iki anahtar var."},{"ru":"Айран холодный.","en":"The ayran is cold.","fr":"L’ayran est froid.","tr":"Ayran soğuk."},{"ru":"Он хочет кофе.","en":"He wants coffee.","fr":"Il veut du café.","tr":"O kahve istiyor."}]},{"id":"B34","section":"reading","prompt":"Ana saat altıda şam yeyir.","choices":[{"ru":"Лейла — моя сестра.","en":"Leyla is my sister.","fr":"Leyla est ma sœur.","tr":"Leyla benim kız kardeşim."},{"ru":"В воскресенье я отдыхаю.","en":"On Sunday I rest.","fr":"Le dimanche, je me repose.","tr":"Pazar günü dinleniyorum."},{"ru":"Завтра 15 июня.","en":"Tomorrow is 15 June.","fr":"Demain, c’est le 15 juin.","tr":"Yarın 15 haziran."},{"ru":"Мама ужинает в шесть.","en":"Mum has dinner at six.","fr":"Maman dîne à six heures.","tr":"Annem altıda akşam yemeği yiyor."}]},{"id":"B35","section":"reading","prompt":"Bu paltar yaşıldır.","choices":[{"ru":"Это платье зелёное.","en":"This dress is green.","fr":"Cette robe est verte.","tr":"Bu elbise yeşil."},{"ru":"На кассе я заплатил.","en":"At the till I paid.","fr":"À la caisse, j’ai payé.","tr":"Kasada ödedim."},{"ru":"Весной погода солнечная.","en":"In spring the weather is sunny.","fr":"Au printemps, il fait un temps ensoleillé.","tr":"İlkbaharda hava güneşli."},{"ru":"Новый год зимой.","en":"New Year is in winter.","fr":"Le Nouvel An est en hiver.","tr":"Yılbaşı kışın."}]},{"id":"B36","section":"reading","prompt":"Lənkərandan Bakıya yol uzaqdır.","choices":[{"ru":"Эта книга моя, а та ручка твоя.","en":"This book is mine, and that pen is yours.","fr":"Ce livre est à moi, et ce stylo est à toi.","tr":"Bu kitap benim, o kalem senin."},{"ru":"Я спрашиваю, сколько стоит.","en":"I am asking how much it costs.","fr":"Je demande combien ça coûte.","tr":"Fiyatın ne kadar olduğunu soruyorum."},{"ru":"Рашид не согласен.","en":"Rashid does not agree.","fr":"Rachid n’est pas d’accord.","tr":"Reşit katılmıyor."},{"ru":"От Лянкяраня до Баку далеко.","en":"From Lankaran to Baku it is far.","fr":"De Lenkoran à Bakou, la route est longue.","tr":"Lenkeran’dan Bakü’ye yol uzun."}]},{"id":"B37","section":"reading","prompt":"Qiymət baha deyil, ona görə alıram.","choices":[{"ru":"Лейла купила молоко.","en":"Leyla bought milk.","fr":"Leyla a acheté du lait.","tr":"Leyla süt aldı."},{"ru":"Больше не хочу.","en":"I do not want any more.","fr":"Je n’en veux plus.","tr":"Daha fazla istemiyorum."},{"ru":"Мы были друзьями.","en":"We were friends.","fr":"Nous étions amis.","tr":"Arkadaştık."},{"ru":"Цена недорогая, поэтому я покупаю.","en":"The price is not high, so I buy it.","fr":"Le prix n’est pas élevé, donc j’achète.","tr":"Fiyat pahalı değil, bu yüzden alıyorum."}]},{"id":"B38","section":"reading","prompt":"Sən məni görürsən?","choices":[{"ru":"Сахара нет.","en":"There is no sugar.","fr":"Il n’y a pas de sucre.","tr":"Şeker yok."},{"ru":"У меня хорошее настроение.","en":"I am in a good mood.","fr":"Je suis de bonne humeur.","tr":"Keyfim iyi."},{"ru":"Ты видишь меня?","en":"Do you see me?","fr":"Tu me vois ?","tr":"Beni görüyor musun?"},{"ru":"Моя мечта — однажды жить в Баку.","en":"My dream is to live in Baku one day.","fr":"Mon rêve est de vivre un jour à Bakou.","tr":"Hayalim bir gün Bakü’de yaşamak."}]},{"id":"B39","section":"reading","prompt":"Bu gün dostumdayam.","choices":[{"ru":"Сегодня я у друга.","en":"Today I am at my friend's.","fr":"Aujourd’hui, je suis chez mon ami.","tr":"Bugün arkadaşımdayım."},{"ru":"Метро далеко.","en":"The metro is far.","fr":"Le métro est loin.","tr":"Metro uzak."},{"ru":"Дайте это без лука.","en":"Give me this without onion.","fr":"Donnez-moi ceci sans oignon.","tr":"Bunu soğansız verin."},{"ru":"Из номера нужно выехать до двенадцати.","en":"You must leave the room by twelve.","fr":"Il faut quitter la chambre avant midi.","tr":"Saat on ikiye kadar odadan çıkmak lazım."}]},{"id":"B40","section":"reading","prompt":"Poçt yaxındır.","choices":[{"ru":"Почта близко.","en":"The post office is near.","fr":"La poste est proche.","tr":"Postane yakın."},{"ru":"Чеснок есть?","en":"Is there garlic?","fr":"Y a-t-il de l’ail ?","tr":"Sarımsak var mı?"},{"ru":"Откуда это блюдо?","en":"Where does this dish come from?","fr":"D’où vient ce plat ?","tr":"Bu yemek nereden?"},{"ru":"Для регистрации нужен паспорт.","en":"For registration a passport is needed.","fr":"Pour l’enregistrement, il faut un passeport.","tr":"Kayıt için pasaport lazım."}]}]}}
